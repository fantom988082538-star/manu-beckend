# === Скопируй этот файл в .env и заполни реальными значениями ===
# .env НИКОГДА не должен попадать в git (см. .gitignore)

PORT=4000
NODE_ENV=development

# --- Ключи авторизации сайта ---
JWT_SECRET=замени_на_длинную_случайную_строку

# --- Главный администратор (создаётся автоматически при первом запуске сервера) ---
ADMIN_PHONE=+992075536886
ADMIN_PASSWORD=замени_на_надёжный_пароль

# --- API поставщика донатов: ALU API (aluu.in) ---
# Сюда вставляется ключ, который тебе выдал ALU.
# Заполняется ТОЛЬКО на сервере, фронтенд этот файл никогда не видит.
SUPPLIER_BASE_URL=https://aluu.in/api/v.1
SUPPLIER_API_KEY=вставь_сюда_свой_api_key
SUPPLIER_SECRET_KEY=вставь_сюда_свой_secret_key

# Публичный адрес ТВОЕГО сервера — нужен, чтобы ALU знал, куда слать вебхук
# со статусом заказа. Пока сервер локальный — оставь пустым.
# После деплоя (этап 8) впиши сюда https://api.manushop.tj
WEBHOOK_BASE_URL=

# --- Платёжные системы (заполняются на этапе 5, если подключите приём онлайн-оплаты) ---
ALIF_MERCHANT_ID=
ALIF_SECRET_KEY=
DC_MERCHANT_ID=
DC_SECRET_KEY=
BANK_CARD_GATEWAY_KEY=
